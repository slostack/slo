/* Quiet Tokyo Night presentation: flat surfaces, muted chrome and sparse semantic color.
 * Header and Footer are one row tall: never give them a border, or it consumes
 * that row and hides the workspace/session title and key hints. */

Screen {
    background: $surface;
    padding: 0 1;
}

Header {
    background: $surface;
    color: $text-dim;
}

Header .header--title,
Header .header--subtitle {
    color: $text-dim;
}

Footer {
    background: $surface;
    color: $text-dim;
}

/* Shortcut keys (clear, expand/collapse, copy…) use the theme's shortcut-key
 * accent; descriptions stay dim so the keys read first. */
Footer FooterKey {
    color: $text-dim;
    background: $surface;
}

Footer FooterKey .footer-key--key {
    color: $shortcut-key;
    background: $surface;
    text-style: bold;
    padding: 0;
}

Footer FooterKey .footer-key--description {
    color: $text-dim;
    background: $surface;
}

Footer FooterKey:hover .footer-key--key,
Footer FooterKey:hover .footer-key--description {
    color: $shortcut-key;
    background: $panel;
}

#chat-shell {
    height: 1fr;
}

#status-region {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
}

/* Component styling lives in the widget/component DEFAULT_CSS and adjacent TCSS. */
