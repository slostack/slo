/* src/tui/app.tcss
 *
 * Minimal layout inspired by Claude Code's CLI:
 *   - No frame around the transcript; conversation flows on the surface.
 *   - Prompt input framed only by two horizontal accent rules (top and
 *     bottom); no side edges or corners, in focused and unfocused states.
 *   - Subtle header/footer so the conversation is the focal point.
 *
 * Colours resolve through the active Textual theme (tokyo-night by
 * default) via $surface / $accent, so runtime theme switches via the
 * command palette stay coherent.
 */

Screen {
    background: $surface;
    padding: 0 1;
}

Header {
    background: $surface;
}

Footer {
    background: $surface;
}

#chat-shell {
    height: 1fr;
}

#status-region {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
}

PromptInput, PromptInput:focus {
    border: none;
    border-top: solid $accent;
    border-bottom: solid $accent;
    background: $surface;
    height: auto;
    min-height: 3;
    max-height: 17;
    padding: 0 1;
    margin: 1 0 0 0;
}

/* Spinner glyph/text styling lives in ThinkingSpinner.DEFAULT_CSS (72.a.5). */

/* Workflow session list (feature 94 a.2): one heading plus at most five
 * one-line rows, never more than a quarter of the screen. Short screens keep
 * one row so the editor and usage bar stay reachable; below the minimum
 * interactive size (60x20) a compact notice replaces the rows. The size
 * classes come from SloTUI's breakpoints. */
SubAgentFleetPanel {
    height: auto;
    max-height: 25vh;
}

SubAgentFleetPanel > .workflow-sessions-heading {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

SubAgentFleetPanel > .workflow-sessions-resize-notice {
    display: none;
    height: 1;
    padding: 0 1;
    color: $warning;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

SubAgentFleetPanel > FleetSessionList {
    height: auto;
    min-height: 1;
    max-height: 5;
    background: $surface;
}

SubAgentFleetRow {
    height: 1;
}

SubAgentFleetRow > Static {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Screen.-workflow-short-height SubAgentFleetPanel > FleetSessionList {
    max-height: 1;
}

Screen.-workflow-below-minimum-width SubAgentFleetPanel > FleetSessionList,
Screen.-workflow-below-minimum-height SubAgentFleetPanel > FleetSessionList {
    display: none;
}

Screen.-workflow-below-minimum-width SubAgentFleetPanel > .workflow-sessions-resize-notice,
Screen.-workflow-below-minimum-height SubAgentFleetPanel > .workflow-sessions-resize-notice {
    display: block;
}
