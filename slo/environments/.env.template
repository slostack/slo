# Slo environment template.
#
# Copy this file to development.env / tests.env / local.env and fill the
# values for your machine. The three concrete files are gitignored.
#
# Variable names match config/cfg.py. Anything cfg.py reads as os.environ.get
# is listed here; defaults from cfg.py are noted in comments.

# ---- Runtime ----
PYTHONPATH=/absolute/path/to/slo-harness/slo
SLO_ENV=development                    # one of: development, test, staging
SLO_ROOT_DIR=/absolute/path/to/slo-harness/slo
SLO_APP_DIR=/absolute/path/to/slo-harness/slo
SLO_APP_NAME=slo                       # cfg default: slo
SLO_DOMAIN=localhost:7700              # cfg default: localhost:7700
SLO_BASE_URL=http://localhost:7700/slo # cfg default: http://localhost:7700/slo
SLO_LOG_FORMAT=text                    # cfg default: json

# ---- Network ports ----
SLO_A2A_PORT=9900                      # cfg default: 9900
SLO_A2A_PUBLIC_URL=http://localhost:9900
SLO_WEB_PORT=7700                      # cfg default: 7700

# ---- LLM ----
# Default model. OpenAI examples: gpt-5-codex, gpt-5.3-codex,
# gpt-5.3-codex-spark, gpt-5.2-codex, gpt-5.4, gpt-5, gpt-4.1, gpt-4o, o3, o1
# Anthropic examples: claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5
# Kimi example: kimi-for-coding
SLO_DEFAULT_MODEL_NAME=gpt-5.4
# Provider keys: leave unset to use ~/.claude/.credentials.json (Claude OAuth, 01.n)
# SLO_ANTHROPIC_API_KEY=<set-locally>
# SLO_OPENAI_API_KEY=<set-locally>

# ---- Skills + KB (01.l, 01.n) ----
# SLO_SKILLS_DIR override; defaults to ~/.slo/skills (installed) or <repo>/skills (dev)
# SLO_SKILLS_DIR=
# SLO_KB_DIR is the local one-way KB mirror; cfg default: unset
# SLO_KB_DIR=/absolute/path/to/kb-mirror
# SLO_KB_SOURCE is the canonical KB path used by `make kb-snapshot`
# SLO_KB_SOURCE=/Users/<you>/Code/KnowledgeBase/KB

# ---- Tool defaults ----
# SLO_TOOL_BASE_DIR defaults to os.getcwd()
# SLO_TOOL_BASE_DIR=
