+def inherited_herdr_names() -> tuple[str, ...]:
+    """Select inherited integration keys without retaining their values.
+
+    Returns:
+        tuple[str, ...]: Names to remove before imports and per-test rebinding.
+    """
+    return tuple(
+        name
