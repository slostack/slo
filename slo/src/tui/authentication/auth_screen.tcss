#auth-modal-body {
    background: $surface;
    border: solid $border-hairline;
    padding: 1 2;
    width: 76;
    max-width: 100%;
    height: auto;
    /* Cap at screen height so tall browser steps scroll without hiding actions. */
    max-height: 100%;
    overflow-y: auto;
    scrollbar-color: $border-hairline;
}

#auth-modal-body OAuthStatusWidget {
    height: auto;
}

AuthenticationScreen .screen--selection {
    background: $auth-selection-background;
    color: $auth-selection-foreground;
}

.auth-title { color: $text-muted; text-style: none; margin-bottom: 1; }
.auth-instruction, .auth-url, .auth-redirect {
    color: $foreground;
    width: 1fr;
    margin-bottom: 1;
}
#auth-modal-body .auth-url,
#auth-modal-body .auth-redirect {
    overflow-x: hidden;
    text-wrap: wrap;
}

#auth-modal-body AuthorizationLink.auth-url {
    color: $foreground;
    text-style: underline;
}
#auth-modal-body AuthorizationLink.auth-url:hover,
#auth-modal-body AuthorizationLink.auth-url:focus {
    color: $text-muted;
    text-style: bold underline;
}
.auth-device-code { color: $warning; text-style: bold; margin-bottom: 1; }
.auth-error { color: $error; margin-top: 1; height: auto; }
#auth-modal-body ApiKeyInputWidget {
    height: auto;
}
#auth-modal-body Button.-primary {
    background: $accent;
    color: $button-color-foreground;
    text-style: bold;
}
#auth-modal-body Button.-primary:hover,
#auth-modal-body Button.-primary:focus {
    background: $text-muted;
    color: $surface;
    border: solid $border-hairline;
}

RadioSet {
    margin-bottom: 1;
}

#auth-modal-body .auth-actions {
    layout: horizontal;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

#auth-modal-body .auth-actions Button {
    width: auto;
    min-width: 12;
    margin-left: 2;
}

#auth-modal-body #oauth-response-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

#auth-modal-body #oauth-response-input {
    width: 1fr;
}

#auth-modal-body #oauth-submit-response {
    width: auto;
    min-width: 20;
    margin-left: 2;
}
