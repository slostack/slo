/* Horizontal rules only; colours come from the theme's prompt-border tokens
 * (slo-dark uses the user-message "You" colour, slo-default quiet rule/accent). */

PromptInputComponent {
    border: none;
    border-top: solid $prompt-border;
    border-bottom: solid $prompt-border;
    background: $surface;
    height: auto;
    min-height: 3;
    max-height: 17;
    padding: 0 1;
    margin: 1 0 0 0;
}

PromptInputComponent:focus {
    border: none;
    border-top: solid $prompt-border-focus;
    border-bottom: solid $prompt-border-focus;
    background: $surface;
    height: auto;
    min-height: 3;
    max-height: 17;
    padding: 0 1;
    margin: 1 0 0 0;
}
