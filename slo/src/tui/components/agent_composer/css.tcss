AgentComposerComponent {
    height: auto;
    max-height: 14;
    border-top: solid $border-hairline;
    padding: 0 1;
    & .agent-composer-header {
        color: $text-muted;
        height: 1;
    }
    & .agent-composer-status {
        color: $text-muted;
        height: auto;
    }
    & .agent-composer-notes {
        color: $text-muted;
        height: auto;
        max-height: 3;
    }
    & .agent-composer-rows {
        color: $text-muted;
        height: auto;
        max-height: 5;
    }
    & Input {
        border: none;
        border-top: solid $border-hairline;
        border-bottom: solid $border-hairline;
        background: $surface;
        height: 3;
        padding: 0 1;
    }
    & Input:focus {
        border: none;
        border-top: solid $accent;
        border-bottom: solid $accent;
        background: $surface;
        height: 3;
        padding: 0 1;
    }
}

AgentComposerComponent.-agent-finished Input {
    color: $text-disabled;
}
