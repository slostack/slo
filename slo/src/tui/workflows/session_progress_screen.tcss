/* Session progress modal (feature 94 a.3); rules follow the approved demo. */

SessionProgressScreen {
    align: center middle;
    background: $background 65%;
}

#progress-box {
    width: 92%;
    height: 88%;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}

#progress-heading {
    height: 1;
    width: 1fr;
    color: $accent;
    text-style: bold;
}

#task-scroll {
    height: 3;
    background: $surface;
}

#task-description {
    height: auto;
    color: $text;
}

#session-state {
    height: auto;
    color: $text-muted;
}

#session-log {
    height: 1fr;
    min-height: 3;
    background: $surface;
    border: none;
}

/* One terminal cell is the minimum usable thickness on either axis.
   Keep the thumb quiet at rest, with a modest hover/drag affordance. */
SessionProgressScreen #session-log,
SessionProgressScreen #task-scroll {
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $text 18%;
    scrollbar-color-hover: $text 30%;
    scrollbar-color-active: $text 40%;
    scrollbar-corner-color: $surface;
}

SessionProgressScreen .hint {
    height: 1;
    color: $text-dim;
}

SessionProgressScreen .actions {
    height: auto;
    align-horizontal: right;
}

SessionProgressScreen .actions Button {
    min-width: 12;
    width: auto;
    margin-left: 1;
}

/* Below 80 columns: stacked single-row buttons and no hint keep controls reachable at 60x20. */

SessionProgressScreen.-progress-narrow #progress-box {
    padding: 0 1;
}

SessionProgressScreen.-progress-narrow .hint {
    display: none;
}

SessionProgressScreen.-progress-narrow .actions {
    layout: vertical;
    align-horizontal: left;
}

SessionProgressScreen.-progress-narrow .actions Button {
    width: 1fr;
    height: 1;
    min-width: 0;
    margin-left: 0;
    border: none;
}

/* Agent composer height budget (108.3/108.4). The box keeps 88% of the screen;
   its footer (hint + actions) is docked, so the flow above it must fit in what
   is left. A full composer is 14 rows, which fits beside a 3-row log from 35
   rows; shorter screens compact the task text and composer instead of letting
   notes or delivery rows push content under the footer. */

#progress-footer {
    dock: bottom;
    height: auto;
}

/* 24-34 rows: one task row and a 7-row composer (prompt, status, newest note,
   two newest delivery rows); at 24 rows this exactly fills the space left. */

SessionProgressScreen.-progress-medium #progress-box.-with-composer #task-scroll,
SessionProgressScreen.-progress-short #progress-box.-with-composer #task-scroll {
    height: 1;
}

SessionProgressScreen.-progress-medium #progress-box.-with-composer AgentComposerComponent {
    max-height: 7;
    border-top: none;
}

SessionProgressScreen.-progress-medium #progress-box.-with-composer .agent-composer-header {
    display: none;
}

SessionProgressScreen.-progress-medium #progress-box.-with-composer .agent-composer-notes {
    max-height: 1;
}

SessionProgressScreen.-progress-medium #progress-box.-with-composer .agent-composer-rows {
    max-height: 2;
}

/* Below 24 rows: no hint, and the composer keeps only its prompt and status
   line; notes and delivery rows return from 24 rows. */

SessionProgressScreen.-progress-short #progress-box.-with-composer .hint {
    display: none;
}

SessionProgressScreen.-progress-short #progress-box.-with-composer AgentComposerComponent {
    max-height: 4;
    border-top: none;
}

SessionProgressScreen.-progress-short #progress-box.-with-composer .agent-composer-header,
SessionProgressScreen.-progress-short #progress-box.-with-composer .agent-composer-notes,
SessionProgressScreen.-progress-short #progress-box.-with-composer .agent-composer-rows {
    display: none;
}
